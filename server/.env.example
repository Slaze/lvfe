# Copy to server/.env (gitignored). Never commit real secrets.

# Listen port (default 18787 — avoid clashing with other local tools on 8787)
PORT=18787

# Shared secret for production pushes. Required when NODE_ENV=production.
# Client sends Authorization: Bearer <SAVE_SECRET>
SAVE_SECRET=

# Allow Authorization: Bearer lvfe-dev:<playerKey> without SAVE_SECRET.
# Default on for local; set 0 in any public deploy.
LVFE_ALLOW_DEV_AUTH=1

# Optional Google Identity Web client ID. When set, Authorization: Bearer google:<id_token>
# is verified (aud must match). Until filled, Gmail production path fails loud.
GOOGLE_WEB_CLIENT_ID=

# Directory for JSON save files (default ./data/saves)
SAVE_DIR=

# Max JSON body bytes (default 2621440 ≈ 2.5 MiB)
MAX_BODY_BYTES=2621440
